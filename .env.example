# 复制为 .env 后填写；.env 已被 .gitignore 忽略，切勿提交。
# 三个组件的实现选择，默认全部 mock。
XTD_FETCHER=mock
XTD_SUMMARIZER=mock
XTD_PUBLISHER=file

# 调度：5 段 cron 表达式（分 时 日 月 周），默认每天 09:00
XTD_CRON=0 9 * * *

# file 推送的输出目录
XTD_OUTPUT_DIR=out

# 摘要模型（OpenAI 兼容 chat completions）。mock 模式下不会读取。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
