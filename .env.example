# 复制为 .env 后填写；.env 已被 .gitignore 忽略，切勿提交。
# 三个组件的实现选择，默认全部 mock。
XTD_FETCHER=mock
# XTD_SUMMARIZER 可选 mock / openai / deepseek（后两者等价，会调用真实模型，需要 key）
XTD_SUMMARIZER=mock
XTD_PUBLISHER=file

# XTD_FETCHER 可选 mock / json / xapi
# json：从本地 JSON 快照读取（格式见 README，示例 examples/snapshot.json）
XTD_SNAPSHOT_PATH=
# xapi：X API v2，会访问真实接口并消耗额度
X_BEARER_TOKEN=
XTD_WOEID=1
XTD_MAX_POSTS=10
XTD_TRENDS_FOR_POSTS=3
XTD_FETCH_TIMEOUT=30

# 调度：5 段 cron 表达式（分 时 日 月 周），默认每天 09:00
XTD_CRON=0 9 * * *

# file 推送的输出目录
XTD_OUTPUT_DIR=out

# 摘要模型（OpenAI 兼容 chat completions）。mock 模式下不会读取。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 单次网络读写超时（秒）
DEEPSEEK_TIMEOUT=30
# 整个模型调用的总时长上限（秒）；超时或出错会退回备用摘要并在邮件里标注
DEEPSEEK_TOTAL_TIMEOUT=60
